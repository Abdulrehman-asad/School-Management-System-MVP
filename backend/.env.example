# ---------- Database ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Abdul@1123
DB_NAME=shaheen_school_erp

# ---------- JWT ----------
JWT_SECRET_KEY=replace_this_with_a_long_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- App ----------
APP_NAME=Shaheen Model Girls High School ERP
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080

# ---------- Frontend (used to build links inside emails) ----------
FRONTEND_BASE_URL=http://localhost:8080/frontend

# ---------- Email / SMTP ----------
# Leave SMTP_HOST empty to run in "dev mode": password reset emails are
# logged to the console and written to backend/uploads/dev_emails/ instead
# of being sent, so the full flow works without real mail credentials.
# For real delivery, common providers:
#   Gmail:        smtp.gmail.com : 587  (use an App Password, not your login password)
#   SendGrid:     smtp.sendgrid.net : 587  (SMTP_USER=apikey, SMTP_PASSWORD=<your key>)
#   Mailgun:      smtp.mailgun.org : 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@shaheenmodelschool.edu.pk
SMTP_FROM_NAME=Shaheen Model Girls High School
SMTP_USE_TLS=True

# ---------- File uploads ----------
UPLOAD_DIR=uploads
MAX_PROFILE_PHOTO_MB=2
MAX_HOMEWORK_ATTACHMENT_MB=10
